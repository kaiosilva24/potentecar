# Caddyfile do Railway (Railpack) — igual ao padrão + cache de assets
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Arquivos com hash no nome (Vite) nunca mudam: cache de 1 ano no navegador.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML e demais arquivos: sempre revalidar, para um deploy novo aparecer na hora.
	@notAssets not path /assets/*
	header @notAssets Cache-Control "no-cache"

	root * {{.DIST_DIR}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		zstd
		gzip
	}

	try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}
}
